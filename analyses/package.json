{
  "name": "dropshipper-poste-analyses",
  "version": "0.5.0",
  "description": "KANTIX ANALYSER — producteur d'analyses de marché pour plusieurs projets : clés IA au choix, brief avec Claude, analyses planifiées, navigateur à onglets connectés, flux signé vers chaque site. DropShipper y est un connecteur.",
  "author": "DropShipper IA <contact@drop-shipper.fr>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node banc/check-poste.cjs && node banc/check-kantix.cjs",
    "check:fenetre": "node banc/check-fenetre.cjs",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "fr.drop-shipper.poste-analyses",
    "productName": "KANTIX ANALYSER",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "data/**",
      "prompts/**",
      "build/icon.png"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
