{
  "name": "dropshipper-poste-analyses",
  "version": "0.2.0",
  "description": "Poste d'analyses DropShipper — les agents d'analyse de marché, un navigateur privé à sessions persistantes et le dossier de dépôt des rapports, sur un PC dédié.",
  "author": "DropShipper IA <contact@drop-shipper.fr>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node banc/check-poste.cjs",
    "check:fenetre": "node banc/check-fenetre.cjs",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "fr.drop-shipper.poste-analyses",
    "productName": "DropShipper Poste d'analyses",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "data/**", "prompts/**", "build/icon.png"],
    "extraResources": [],
    "win": { "target": ["nsis"], "icon": "build/icon.png", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
