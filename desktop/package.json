{
  "name": "dropshipper-desktop",
  "version": "0.5.0",
  "description": "DropShipper Desktop — le compagnon de l'application drop-shipper.fr : sessions marchandes, file de travail, mode automatique encadré.",
  "author": "DropShipper IA <contact@drop-shipper.fr>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node copier-extraction.cjs && electron .",
    "check": "node copier-extraction.cjs && node check-desktop.cjs",
    "check:fenetre": "node check-fenetre.cjs",
    "check:pilote": "electron check-pilote.cjs",
    "check:achats": "electron check-achats.cjs",
    "check:releve": "node copier-extraction.cjs && electron check-releve.cjs",
    "build": "node copier-extraction.cjs && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "fr.drop-shipper.desktop",
    "productName": "DropShipper Desktop",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "site-preload.js", "lib/**", "renderer/**", "extraction/**", "build/icon.png"],
    "win": { "target": ["nsis", "msi"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "msi": { "oneClick": false }
  }
}
