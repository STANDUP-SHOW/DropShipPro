# ===== n8n =====
NODE_FUNCTION_ALLOW_BUILTIN=fs,path
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
MARKET_ANALYSES_DIR=/data/MARKET-ANALYSES

# ===== Claude (rédaction des sections) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# ===== Browserless (Minea + Dropship) =====
BROWSERLESS_URL=http://localhost:3000
BROWSERLESS_TOKEN=

# ===== MINEA-SPY =====
MINEA_COOKIES=[]                 # JSON des cookies de session app.minea.com (export navigateur)
MINEA_PLAN=free                  # free | starter | premium | business

# ===== DROPSHIP-SPY =====
DROPSHIP_COOKIES=[]              # JSON des cookies de session app.dropship.io
DROPSHIP_PLAN=trial              # trial | basic | standard | premium
DROPSHIP_RAYONS_PAR_JOUR=1       # nb de rayons qui partagent le quota ce jour-là
DROPSHIP_RENEWAL_DAY=1           # jour du mois de renouvellement
DROPSHIP_TRIAL_DAYS_LEFT=7
DROPSHIP_CREDIT_RESERVE_PCT=0.05

# ===== TIKTOK-SPY (Commercial Content API) =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_COUNTRY=FR
TIKTOK_MAX_PAGES_PER_KEYWORD=5

# ===== META-SPY (Ad Library API) =====
META_ADLIB_TOKEN=                # token utilisateur long-lived (~60 j)
META_API_VERSION=v23.0
META_COUNTRIES=FR
META_LOOKBACK_DAYS=30
META_MAX_PAGES_PER_KEYWORD=4
META_PAGE_SIZE=50
