generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  OWN_SITE
  LEBONCOIN
  VINTED
  EBAY
  AMAZON
  FACEBOOK
  CDISCOUNT
  GOOGLE_SHOPPING
  TIKTOK_SHOP
  WISH
  LA_REDOUTE
  LECLERC
  BHV
  SPARTOO
  ATLAS_FOR_MEN
  KIABI
  ETSY
  BRANDALLEY
  MIINTO
  SHOPIFY
  INSTAGRAM
}

enum ProductStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum OrderStatus {
  NEW
  ORDERED_FROM_SUPPLIER
  SHIPPED
  DELIVERED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  RELEASED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  shopName          String?
  /// Identifiant public de la boutique, utilisé dans l'URL du catalogue.
  /// Distinct de l'id du compte : il peut être publié sans exposer l'identité interne.
  shopKey           String    @unique @default(cuid())
  watermarkText     String?
  /// Chemin du logo servi via /storage ; prioritaire sur watermarkText quand il est défini.
  watermarkImage    String?
  /// Largeur du filigrane en % de la largeur de la photo.
  watermarkScale    Int       @default(22)
  /// Opacité du filigrane, de 10 à 100.
  watermarkOpacity  Int       @default(75)
  /// Coin ou bord où poser le filigrane (south, southeast, center…).
  watermarkPosition String    @default("southeast")
  /// Null until the address is confirmed through the emailed link.
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())

  /// Annonces importables restantes. 10 offertes à l'inscription.
  /// La publication ne consomme rien : seul l'import est décompté.
  credits              Int       @default(10)
  /// FREE tant qu'aucun abonnement n'est actif, PREMIUM = imports illimités.
  plan                 Plan      @default(FREE)
  /// Identifiants Stripe. Null tant que l'utilisateur n'a jamais payé.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  /// Agent de controle visuel des photos et des options, avant mise en ligne.
  /// Actif par defaut : c est lui qui rend le mode automatique fiable.
  controlAgent         Boolean   @default(true)
  /// Fin de la période payée : l'abonnement reste actif jusque-là même résilié.
  premiumUntil         DateTime?

  shops         Shop[]
  products      Product[]
  credentials   PlatformCredential[]
  payments      Payment[]
  orders        Order[]
  authTokens    AuthToken[]
  apiKeys       ApiKey[]
  opportunities Opportunity[]
  signals       Signal[]
  review        Review?
  Department    Department[]
  Report        Report[]
  ChatMessage   ChatMessage[]
  autopilot     Autopilot?
  conversations Conversation[]
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Single-use tokens for password reset and address confirmation.
/// Only the SHA-256 hash is stored: a leaked database must not hand out
/// working reset links.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model PlatformCredential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  Platform
  label     String?
  data      Json
  connected Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, platform])
}

model Product {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceUrl      String
  sourceSite     String?
  sourceCategory String?
  /// Catalog entry id (see categoryCatalog.ts) chosen by the user; overrides sourceCategory for mapping.
  categoryId     String?
  /// Boutique de destination pour le flux catalogue. Null = la boutique par defaut.
  shopId         String?
  shop           Shop?   @relation(fields: [shopId], references: [id], onDelete: SetNull)

  title         String
  description   String  @db.Text
  aiTitle       String?
  aiDescription String? @db.Text

  // price = supplier cost (scraped when available, otherwise entered by hand).
  // shippingCost is what the supplier charges to ship; sellingPrice is what the
  // buyer pays. Gross margin = sellingPrice - price - shippingCost.
  price         Decimal @default(0) @db.Decimal(10, 2)
  shippingCost  Decimal @default(0) @db.Decimal(10, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(10, 2)
  currency      String  @default("EUR")
  markupPercent Int     @default(50)

  images   Json
  variants Json?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  /// Amazon-style selling points, one short line each.
  bulletPoints    Json?
  /// Structured product attributes (matière, coupe, saison…) that marketplaces index for filters.
  attributes      Json?

  /// Faux quand le modele n a pas repondu et que le texte source a ete conserve.
  /// L annonce est alors signalee dans l interface et le credit n est pas pris.
  aiEnhanced Boolean @default(true)

  /// Derniere analyse de marche (voir services/marketAnalysis.ts), telle quelle.
  /// Stockee pour ne pas la repayer a chaque affichage.
  marketAnalysis   Json?
  marketAnalysedAt DateTime?

  status ProductStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publications Publication[]
  orders       Order[]
}

model Publication {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform       Platform
  status         PublicationStatus @default(PENDING)
  targetCategory String?
  externalUrl    String?
  error          String?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())

  @@unique([productId, platform])
}

model Order {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  platform        Platform
  externalOrderId String?

  buyerName    String
  buyerAddress Json

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("EUR")

  status           OrderStatus  @default(NEW)
  supplierOrderUrl String?
  trackingNumber   String?
  /// Transporteur, quand la plateforme le donne ou qu on le devine du numero.
  carrier          String?
  /// Adresse email de l acheteur, quand la plateforme la communique. Sans elle,
  /// aucune reponse ne peut partir d ici.
  buyerEmail       String?
  shippingLabelUrl String?
  receiptUrl       String?
  payoutStatus     PayoutStatus @default(PENDING)
  platformBalance  Decimal?     @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Avis laisse par un utilisateur sur l application.
/// Un seul par compte: un testeur qui revient corrige son avis au lieu d en empiler.
model Review {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nom affiche publiquement. Jamais l email, qui reste prive.
  displayName String
  rating      Int
  comment     String   @db.Text
  /// Permet de retirer un avis de la page publique sans le supprimer.
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Plan {
  FREE
  PREMIUM
}

/// Historique des paiements, pour retrouver ce qui a été crédité et pourquoi.
model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant du pack acheté, ou 'premium' pour l'abonnement.
  planId          String
  /// Montant réellement encaissé, en centimes, tel que Stripe le rapporte.
  amount          Int
  currency        String   @default("eur")
  /// Crédits ajoutés par ce paiement. 0 pour un abonnement illimité.
  credits         Int      @default(0)
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  @@index([userId])
}

/// Événements Stripe déjà traités.
/// Stripe rejoue un webhook jusqu'à obtenir un 2xx : sans cette table, un
/// rejeu créditerait le compte une seconde fois.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Une boutique du vendeur, avec sa propre cle de catalogue.
///
/// Un vendeur qui tient un site de mode et un site high-tech ne peut pas exposer
/// le meme flux aux deux: chaque boutique a sa cle, et chaque annonce est rangee
/// dans l une d elles.
model Shop {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Identifiant public, utilise dans l URL du flux. Jamais l id interne.
  shopKey   String   @unique @default(cuid())
  /// Type de site branche, a titre indicatif: wordpress, prestashop, magento...
  platform  String?
  createdAt DateTime @default(now())

  products Product[]

  @@index([userId])
}

/// Cle d API machine : un agent externe ecrit dans le catalogue sans mot de passe.
///
/// Seul le SHA-256 est stocke. La cle en clair n est montree qu une fois, a la
/// creation : une base qui fuit ne doit pas distribuer des acces en etat de
/// marche, et une cle qu on peut relire finit toujours par etre relue.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ce que la cle pilote, en clair : « Agent high-tech base44 ».
  name       String
  keyHash    String    @unique
  /// Debut de la cle, affiche pour reconnaitre laquelle est laquelle.
  prefix     String
  lastUsedAt DateTime?
  /// Une cle revoquee est conservee : savoir qu elle a existe compte.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum OpportunityStatus {
  NEW
  KEPT
  REJECTED
  IMPORTED
}

/// Un produit repere par un agent de veille, en attente d arbitrage humain.
///
/// L agent propose, le vendeur dispose : rien n est importe ni publie sans un
/// geste de sa part. Un import coute un credit et engage son catalogue.
model Opportunity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Plateforme d origine, telle que l agent la nomme : temu, aliexpress...
  source    String
  sourceUrl String
  title     String
  image     String?
  category  String?

  /// Prix chez le fournisseur, et prix moyen constate sur les places de marche.
  sourcePrice Decimal  @db.Decimal(10, 2)
  marketPrice Decimal? @db.Decimal(10, 2)
  currency    String   @default("EUR")

  /// Compteur affiche par la plateforme source. Null quand elle n en publie pas
  /// — ce qui est le cas d Amazon : l absence doit se voir, pas se deviner.
  salesCount   Int?
  /// Trois etats : oui, non, et inconnu — qui est le cas le plus frequent.
  /// « Pas confirme » n est pas « pas de stock » : confondre les deux fait jeter
  /// des produits valables, ce qui est exactement ce qu on a constate.
  euStock      Boolean?
  deliveryDays Int?
  /// Le delai tel que la plateforme l ecrit, quand il n est pas un nombre.
  deliveryText String?
  warranty     String?
  isNew        Boolean  @default(false)

  /// Ce que l agent en dit, et sa reponse brute pour pouvoir la relire.
  notes String? @db.Text
  raw   Json?

  /// Le rayon dont l agent a repere ce produit. Null pour un depot sans rayon.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  status     OpportunityStatus @default(NEW)
  /// Renseigne quand l opportunite a donne lieu a un import.
  productId  String?
  detectedAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  /// Le meme produit repere deux fois ne fait pas deux lignes.
  @@unique([userId, sourceUrl])
  @@index([userId, status])
}

enum SignalKind {
  SOCIAL
  MARKET
}

enum SignalStatus {
  NEW
  KEPT
  REJECTED
}

/// Un signal de marche repere par un agent de veille.
///
/// Distinct d Opportunity : une opportunite est un produit qu on peut importer,
/// un signal est une information — une marque qui perce sur TikTok Shop, une
/// categorie en croissance, un prix constate. On ne l importe pas, on en tient
/// compte.
model Signal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     SignalKind
  /// tiktok, instagram, facebook, amazon, cdiscount...
  platform String?
  title    String
  summary  String?    @db.Text
  url      String?
  category String?
  /// Marque ou boutique concernee, quand le signal en designe une.
  brand    String?

  /// Chiffres tels que l agent les rapporte, sans schema impose : le GMV, les
  /// unites, la croissance et le prix moyen ne sont jamais tous disponibles.
  metrics Json?

  /// Scores de 0 a 100. Ce sont des estimations, jamais des taux de conversion
  /// proprietaires — les plateformes ne les publient pas.
  engagementScore Int?
  trendScore      Int?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  isNew  Boolean      @default(false)
  status SignalStatus @default(NEW)
  notes  String?      @db.Text
  raw    Json?

  /// Empreinte de deduplication : le meme signal revu a chaque scan ne fait pas
  /// une ligne de plus.
  fingerprint String
  detectedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, kind, status])
}

/// Un rayon confie a un agent, chez un vendeur donne.
///
/// Le prenom est fige a l embauche plutot que lu dans le catalogue : le vendeur
/// qui parle d « Albert » depuis trois mois ne doit pas le voir changer de nom
/// parce qu on a modifie une liste dans le code.
model Department {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cle du rayon dans le catalogue (voir services/departments.ts).
  key       String
  agentName String
  createdAt DateTime @default(now())

  opportunities Opportunity[]
  signals       Signal[]
  reports       Report[]
  chatMessages  ChatMessage[]
  conversations Conversation[]

  /// Un rayon n est confie qu une fois : deux « Albert » chez le meme vendeur
  /// rendraient chaque rapport ambigu.
  @@unique([userId, key])
}

/// Un rapport quotidien depose par un chef de rayon.
///
/// Archive tel quel : le vendeur doit pouvoir relire celui d il y a trois
/// semaines et comparer. Un rapport n est jamais recrit, seulement remplace
/// quand l agent redepose le meme jour pour la meme section.
model Report {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// SOCIAL, SUPPLIERS ou MARKET : la section ou le rapport se range.
  section String
  /// Jour couvert par le rapport, au format AAAA-MM-JJ.
  day     String
  title   String
  /// Le corps du rapport en Markdown simple, tel que l agent l a redige.
  body    String @db.Text
  /// Chiffres cles a afficher en tete, sans schema impose.
  summary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // L unicite « un rapport par jour, par section, par rayon » est posee en SQL
  // par deux index partiels : un index unique ordinaire ignore les lignes ou
  // departmentId est NULL, ce qui laisserait s empiler les rapports sans rayon.
  // Prisma ne sait pas exprimer un index partiel, le code fait donc la lecture
  // avant ecriture lui-meme.
  @@index([userId, section])
}

/// Un echange avec un chef de rayon.
///
/// Conserve pour que la conversation reprenne la ou elle s est arretee, et pour
/// que le vendeur retrouve un conseil donne la semaine derniere.
model ChatMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// user ou agent.
  role      String
  content   String   @db.Text
  /// Faux quand la question sortait du rayon : rien n a ete facture.
  billed    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, departmentId])
}

/// Le pilote automatique d un vendeur.
///
/// Il importe et publie sans intervention, dans les limites que le vendeur
/// fixe : chaque import coute un credit et remplit son catalogue, donc le
/// plafond quotidien n est pas optionnel.
model Autopilot {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled        Boolean @default(false)
  /// Imports maximum par jour. Le pilote s arrete net une fois atteint.
  dailyLimit     Int     @default(5)
  /// Publie apres import, sur les destinations a API uniquement.
  autoPublish    Boolean @default(false)
  /// Destinations retenues, parmi celles qui publient reellement.
  destinations   Json?
  /// Marge minimale exigee, en pourcentage du prix fournisseur.
  minMargin      Int     @default(50)
  /// N importe que ce dont le stock europeen est confirme.
  requireEuStock Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AutopilotRun[]
}

/// Le compte rendu d un passage du pilote automatique.
model AutopilotRun {
  id          String    @id @default(cuid())
  userId      String
  autopilotId String
  autopilot   Autopilot @relation(fields: [autopilotId], references: [id], onDelete: Cascade)

  day       String
  imported  Int      @default(0)
  published Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  /// Ligne a ligne, ce qui a ete fait et pourquoi. Le vendeur doit pouvoir
  /// comprendre une decision prise pendant qu il dormait.
  log       Json?
  createdAt DateTime @default(now())

  @@index([userId, day])
}

enum ConversationStatus {
  OPEN
  WAITING
  CLOSED
}

/// Un echange avec un acheteur, quelle que soit la plateforme d origine.
///
/// Le but est que le vendeur n ait plus a ouvrir cinq back-offices pour repondre
/// a cinq questions. Ce qui remonte ici depend de ce que chaque plateforme
/// expose : certaines ont une API de messagerie, d autres rien du tout.
model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform   Platform
  /// Identifiant de la conversation chez la plateforme, quand elle en donne un.
  externalId String?

  customerName  String
  /// Renseigne quand la plateforme le communique : sans lui, aucune reponse
  /// automatique n est possible et le vendeur devra repondre chez elle.
  customerEmail String?

  subject   String?
  productId String?
  orderId   String?

  /// Le rayon dont l agent sait repondre a cette question.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  status        ConversationStatus @default(OPEN)
  /// Faux des que le vendeur a ouvert la conversation.
  unread        Boolean            @default(true)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())

  messages CustomerMessage[]

  // L unicite (userId, platform, externalId) est posee en SQL par un index
  // partiel : la plupart des sources ne donnent aucun identifiant externe, et
  // un index ordinaire considererait toutes ces lignes comme distinctes.
  @@index([userId, status])
  @@index([userId, platform])
}

/// Un message dans une conversation acheteur.
model CustomerMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// IN : recu de l acheteur. OUT : envoye par le vendeur.
  direction String
  body      String  @db.Text
  author    String?

  /// Comment le message est parti : email, api, manuel, ou null a la reception.
  /// « manuel » veut dire que le vendeur doit encore le coller chez la
  /// plateforme — le dire evite de croire une reponse partie alors qu elle dort.
  sentVia String?
  /// Vrai quand le texte a ete redige par l agent du rayon.
  drafted Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId])
}
