# Postgres (local docker-compose, or Railway-provided URL in production)
DATABASE_URL="postgresql://droppost:droppost@localhost:5432/droppost"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# AI (Anthropic Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=""

PORT=4000
FRONTEND_URL="http://localhost:5173"

# Public address of THIS API (https://…up.railway.app). Used when a third party has
# to fetch our own files: Shopify downloads the watermarked photos itself.
PUBLIC_API_URL=""

# Shopify Admin API version. Bump it when Shopify retires the pinned one.
SHOPIFY_API_VERSION="2025-10"

# Stripe. La cle secrete et le secret de signature du webhook viennent du
# tableau de bord Stripe. Sans elles, le paiement est simplement desactive.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudflare R2. Sans ces cinq variables, les photos restent sur le disque du
# conteneur. Avec elles, elles partent en stockage objet, egress gratuit.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Modeles IA par tache. Les defauts sont dans src/services/aiEnhancer.ts.
# La reecriture garde le modele fort, l extraction de variantes passe sur Haiku.
AI_MODEL_ENHANCE="claude-sonnet-4-5"
AI_MODEL_EXTRACT="claude-haiku-4-5"
AI_MODEL_ANALYSIS="claude-opus-5"

# Email SMTP (boite OVH par exemple). Sans SMTP_HOST ni RESEND_API_KEY, aucun
# message ne part : la reinitialisation de mot de passe devient silencieuse.
SMTP_HOST="ssl0.ovh.net"
SMTP_PORT="465"
SMTP_USER="contact@drop-shipper.fr"
SMTP_PASSWORD=""
MAIL_FROM="DropShipper IA <contact@drop-shipper.fr>"
