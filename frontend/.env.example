# Not needed in dev (Vite proxies /api to the backend, see vite.config.ts).
# In production, set this to your deployed backend URL and update src/lib/api.ts
# to use it instead of the relative "/api" base, or configure a Vercel rewrite.
VITE_API_URL=""

# Connexion Google (Sign in with Google). L'ID client OAuth, format
# ...apps.googleusercontent.com — le MÊME que GOOGLE_CLIENT_ID côté backend.
# Vide = le bouton « Continuer avec Google » ne s'affiche pas. Vite fige les
# VITE_* à la compilation : après l'avoir ajouté sur Vercel, redéployer.
VITE_GOOGLE_CLIENT_ID=""
