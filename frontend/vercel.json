{
  "rewrites": [
    {
      "source": "/analyses",
      "destination": "https://dropshippro-production.up.railway.app/analyses/"
    },
    {
      "source": "/analyses/(.*)",
      "destination": "https://dropshippro-production.up.railway.app/analyses/$1"
    },
    {
      "source": "/b/:path*",
      "destination": "https://dropshippro-production.up.railway.app/b/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://dropshippro-production.up.railway.app/api/:path*"
    },
    {
      "source": "/api/aliexpress/:path*",
      "destination": "https://dropshippro-production.up.railway.app/api/aliexpress/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
