{
  "manifest_version": 3,
  "name": "DropShipper IA",
  "version": "1.5.0",
  "description": "Ajoutez un produit à DropShipper IA depuis n'importe quelle boutique, et publiez-le sur vos marketplaces.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "tabGroups"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://localhost:5173/*",
    "https://*.temu.com/*",
    "https://*.joybuy.com/*",
    "https://*.aliexpress.com/*",
    "https://*.vinted.fr/*",
    "https://*.leboncoin.fr/*",
    "https://*.ebay.fr/*",
    "https://*.amazon.fr/*",
    "https://*.facebook.com/*",
    "https://*.cdiscount.com/*",
    "https://*.tiktokglobalshop.com/*",
    "https://merchants.google.com/*",
    "https://drop-shipper.fr/*",
    "https://www.drop-shipper.fr/*",
    "https://drop-ship-pro.vercel.app/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DropShip Pro",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://drop-shipper.fr/*",
        "https://www.drop-shipper.fr/*",
        "https://drop-ship-pro.vercel.app/*"
      ],
      "js": [
        "config.js",
        "content/app-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.leboncoin.fr/*",
        "https://*.ebay.fr/*",
        "https://*.amazon.fr/*",
        "https://*.facebook.com/marketplace/*",
        "https://*.cdiscount.com/*",
        "https://*.tiktokglobalshop.com/*",
        "https://merchants.google.com/*"
      ],
      "js": [
        "config.js",
        "content/fill-helpers.js",
        "content/publish-launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vinted.fr/items/new*"
      ],
      "js": [
        "config.js",
        "content/fill-helpers.js",
        "content/vinted.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.leboncoin.fr/deposer-une-annonce*"
      ],
      "js": [
        "config.js",
        "content/fill-helpers.js",
        "content/leboncoin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ebay.fr/sl/sell*",
        "https://*.ebay.fr/lstng*"
      ],
      "js": [
        "config.js",
        "content/fill-helpers.js",
        "content/ebay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.facebook.com/marketplace/create/*"
      ],
      "js": [
        "config.js",
        "content/fill-helpers.js",
        "content/facebook.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
