{
  "manifest_version": 3,
  "name": "DropShip Pro — Publication assistée",
  "version": "0.1.0",
  "description": "Remplit automatiquement les formulaires de vente Vinted, Leboncoin et eBay avec vos produits DropShip Pro.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://*.vinted.fr/*",
    "https://*.leboncoin.fr/*",
    "https://*.ebay.fr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DropShip Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.vinted.fr/items/new*"],
      "js": ["content/fill-helpers.js", "content/vinted.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.leboncoin.fr/deposer-une-annonce*"],
      "js": ["content/fill-helpers.js", "content/leboncoin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.ebay.fr/sl/sell*", "https://*.ebay.fr/lstng*"],
      "js": ["content/fill-helpers.js", "content/ebay.js"],
      "run_at": "document_idle"
    }
  ]
}
