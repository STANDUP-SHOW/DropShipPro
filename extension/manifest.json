{
  "manifest_version": 3,
  "name": "DropShip Pro — Import & publication assistée",
  "version": "0.2.0",
  "description": "Ajoutez un produit à DropShip Pro depuis Temu ou JoyBuy, et publiez-le sur Vinted, Leboncoin, eBay ou Amazon avec le formulaire pré-rempli.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://*.temu.com/*",
    "https://*.joybuy.com/*",
    "https://*.aliexpress.com/*",
    "https://*.vinted.fr/*",
    "https://*.leboncoin.fr/*",
    "https://*.ebay.fr/*",
    "https://*.amazon.fr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DropShip Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.temu.com/*", "https://*.joybuy.com/*", "https://*.aliexpress.com/*"],
      "js": ["content/fill-helpers.js", "content/capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.leboncoin.fr/*",
        "https://*.ebay.fr/*",
        "https://*.amazon.fr/*"
      ],
      "js": ["content/fill-helpers.js", "content/publish-launcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.vinted.fr/items/new*"],
      "js": ["content/fill-helpers.js", "content/vinted.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.leboncoin.fr/deposer-une-annonce*"],
      "js": ["content/fill-helpers.js", "content/leboncoin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.ebay.fr/sl/sell*", "https://*.ebay.fr/lstng*"],
      "js": ["content/fill-helpers.js", "content/ebay.js"],
      "run_at": "document_idle"
    }
  ]
}
